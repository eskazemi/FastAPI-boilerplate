# .envrc
# تشخیص نسخه پایتون
if [ -f .python-version ]; then
  PY_VER="$(cat .python-version)"
else
  PY_VER="3.11"
fi

# اطمینان از وجود uv
if ! command -v uv >/dev/null 2>&1; then
  echo "ERROR: uv not found. Install uv first." >&2
  exit 1
fi

# نصب پایتون اگر نیاز
uv python install "$PY_VER"

# ایجاد venv اگر وجود ندارد
if [ ! -d .venv ]; then
  uv venv --python "$PY_VER"
fi

# اضافه کردن مسیر venv به PATH
PATH_add ".venv/bin"
export VIRTUAL_ENV="$PWD/.venv"

# watch کردن فایل‌های مهم برای sync خودکار
watch_file pyproject.toml
watch_file uv.lock

# sync فقط وقتی lockfile تغییر کرده (یا همیشه در صورت نبود lock)
if [ -f uv.lock ]; then
  uv sync --frozen || uv sync
else
  uv sync
fi

# بارگذاری .env (اگر وجود دارد)
dotenv_if_exists
